OPENAI_API_KEY=your_key_here
OPENAI_ENABLED=true
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_ENABLED=true
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_ENABLED=true
LOCAL_MODEL_ENABLED=false
LOCAL_MODEL_PATH=/models/local
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgresql://user:password@localhost/klev_ai
REDIS_URL=redis://localhost:6379
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=https://telemetry.klev.ai
POPIA_DATA_RETENTION_DAYS=90
POPIA_CONSENT_REQUIRED=true
KODE_AGENT_ENABLED=true
KODE_AGENT_APPROVAL_REQUIRED=true
