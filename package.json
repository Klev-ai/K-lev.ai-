{
  "name": "klev-ai-platform",
  "version": "1.0.0",
  "description": "K'lev.ai - Sovereign South African AI Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:prompts": "jest --testPathPattern=prompts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "audit": "npm audit",
    "kode-agent": "ts-node kode-agent/cli.ts"
  },
  "keywords": ["AI", "South Africa", "multilingual", "POPIA", "offline-first"],
  "author": "K'lev.ai",
  "license": "PROPRIETARY",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "pino": "^8.0.0",
    "axios": "^1.4.0"
  }
}
